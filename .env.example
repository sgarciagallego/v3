# Copy to .env.local and fill in. Never commit the filled-in file.

# Signs and encrypts the NextAuth session JWT.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# The shared password for the /portfolio route.
NEXTAUTH_PASSWORD=

# Canonical URL NextAuth builds callbacks from. Required in development.
# Vercel infers this in production, so it can be omitted there.
NEXTAUTH_URL=http://localhost:3000
